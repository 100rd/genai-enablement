{
  "note": "Ground-truth severance / skew / recovery matrix for the assembled management-readonly-local-v1 stack (task-sp-98, ADR-0024). AC-SP98-6 (synchronized-local-severance-recovery) expects that stopping/skewing exactly one owner marks ONLY that owner's Portal panel unavailable/stale, preserves the sibling panel and Portal readiness, and that recovery restores fresh truth with no duplicate authoritative transition. Joins Portal service-contract.json#fail_closed_matrix and each owner's own severance evidence; a live capture folds observed outcomes on.",
  "profile_id": "management-readonly-local-v1",
  "invariants": [
    "one_owner_failure_never_blanks_the_other",
    "unavailable_panel_never_carries_owner_content",
    "recovery_restores_fresh_projection_without_duplicate_authoritative_transition"
  ],
  "forbidden_outcomes": ["healthy", "empty", "cached_current", "sibling_blanked", "duplicate_authoritative_transition"],
  "scenarios": [
    {
      "id": "omniscience-stop",
      "owner": "omniscience",
      "action": "docker compose stop omniscience-api",
