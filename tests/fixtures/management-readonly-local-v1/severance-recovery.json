      "unrelated_owner_preserved": "barbarossa_panel_unchanged",
      "portal_readiness_preserved": true,
      "recovery": "restart omniscience-api -> fresh omniscience projection restored",
      "source_ref": "Portal service-contract.json#fail_closed_matrix[owner_unreachable]"
    },
    {
