# ===========================================================================
# management-readonly-local-v1 — assembled environment template (task-sp-98)
# ---------------------------------------------------------------------------
# THE single env file for the assembled synchronized-platform local stack. It
# covers EVERY variable the three owner fragments (SP-95/SP-96/SP-97) read, so
# `docker compose --env-file .env` resolves the whole application from one file.
#
#   * Committed as `.env.example` — it contains NO real secret. Every value here
#     is a LOCAL-DEV placeholder only (ADR-0024 D6 / AC-SP98-9).
#   * Generate a disposable `.env` with high-entropy secrets:
#       python scripts/generate_management_readonly_local_env.py
#     The generator NEVER prints a secret value and NEVER overwrites an existing
#     `.env` (a running store keeps the password from its first init; a reset is
#     the separate explicit `docker compose down -v`).
#   * The generator fills the SECRET block below with fresh random values and
#     copies every non-secret line verbatim. Config-coupled values (ports, DB
#     names/roles, the owner-baked Keycloak client secret, TTLs) are copied, not
#     randomized — randomizing them would desynchronize a baked owner artifact.
# ===========================================================================

# ---------------------------------------------------------------------------
# SECRET block — high-entropy, generator-managed, disposable local dev only.
# The committed placeholders below are NOT real secrets.
# ---------------------------------------------------------------------------
# Omniscience owner-private store/broker credentials (SP-95).
OMNISCIENCE_POSTGRES_PASSWORD=change-me-local-omni-pg
OMNISCIENCE_NEO4J_PASSWORD=change-me-local-omni-neo4j
OMNISCIENCE_QDRANT_API_KEY=change-me-local-omni-qdrant
# Barbarossa owner-private PostgreSQL credential (SP-96). Barbarossa's fragment
# uses the un-prefixed POSTGRES_PASSWORD; it feeds ONLY barbarossa-postgres and
# its DSN (Omniscience/Portal use their own prefixed vars — no collision).
POSTGRES_PASSWORD=change-me-local-barb-pg
# Portal owner-private PostgreSQL credentials (SP-97).
PORTAL_DB_PASSWORD=change-me-local-portal-owner-pg
PORTAL_APP_DB_PASSWORD=change-me-local-portal-app-pg
# Portal Keycloak bootstrap admin password (applied at first Keycloak start).
PORTAL_KEYCLOAK_ADMIN_PASSWORD=change-me-local-kc-admin

# ---------------------------------------------------------------------------
# Config-coupled values — copied verbatim by the generator (NOT randomized).
# ---------------------------------------------------------------------------
# Loopback host bindings (the profile's only three published surfaces).
PORTAL_FRONTEND_PORT=3000
PORTAL_KEYCLOAK_PORT=8081
OMNISCIENCE_ADMIN_PORT=3001

# Portal launch mode label (image = reuse prebuilt tags; source overlay builds).
PORTAL_LOCAL_MODE=image

# Portal-owned PostgreSQL identity (names/roles, not secret).
PORTAL_DB=platform_portal
PORTAL_DB_OWNER=platform_portal_owner
PORTAL_APP_DB_ROLE=portal_app

# Portal Keycloak identity. PORTAL_KEYCLOAK_CLIENT_SECRET is owner-baked into the
# Portal realm-export (a labeled dev-only value, not a real secret) — the client
# and the realm must agree, so it is copied, never randomized.
KEYCLOAK_REALM=synchronised-platform
KEYCLOAK_CLIENT_ID=portal-backend
PORTAL_KEYCLOAK_CLIENT_SECRET=portal-local-secret

# Portal §5 session / token constants (Settings requires these; safe defaults).
SESSION_TTL_SECONDS=28800
SESSION_IDLE_TTL_SECONDS=1800
TENANT_TOKEN_TTL_SECONDS=300
STEPUP_FRESHNESS_WINDOW_SECONDS=300
OMNISCIENCE_WORKSPACE_TOKEN_TTL_CEILING_SECONDS=900

# Omniscience app / model / log identity (not secret).
OMNISCIENCE_APP_VERSION=0.2.0
OMNISCIENCE_LOCAL_MODEL=all-MiniLM-L6-v2
OMNISCIENCE_LOG_LEVEL=info
OMNISCIENCE_QDRANT_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# IMAGE-mode digests (OPTIONAL). Set to pinned @sha256 owner OCI digests for a
# reproducible image-mode run; leave commented to use the source overlay. Mutable
# tags / `latest` are rejected by the owner fragments (MLC-9). None is published
# yet (SP-86 records only pending.image_registry_digest), so the runnable path is
# the source overlay.
# OMNISCIENCE_API_IMAGE=ghcr.io/100rd/omniscience@sha256:<digest>
# OMNISCIENCE_ADMIN_IMAGE=ghcr.io/100rd/omniscience-admin@sha256:<digest>
# BARBAROSSA_API_IMAGE=barbarossa-api@sha256:<digest>
# BARBAROSSA_WORKER_IMAGE=barbarossa-worker@sha256:<digest>
# PORTAL_BACKEND_IMAGE=platform-portal-backend@sha256:<digest>
# PORTAL_FRONTEND_IMAGE=platform-portal-frontend@sha256:<digest>
