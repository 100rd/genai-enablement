{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowOnlyNonprodEuc1EBSCSIController",
      "Effect": "Allow",
      "Principal": {
        "Service": "pods.eks.amazonaws.com"
      },
      "Action": [
        "sts:AssumeRole",
        "sts:TagSession"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/eks-cluster-arn": "arn:aws:eks:eu-central-1:120736097561:cluster/nonprod-euc1",
          "aws:RequestTag/kubernetes-namespace": "kube-system",
          "aws:RequestTag/kubernetes-service-account": "ebs-csi-controller-sa"
        }
      }
    }
  ]
}
